{
  plugins: {
    ros2dds: {
      domain: 0,
      ros_automatic_discovery_range: "LOCALHOST",
      ros_localhost_only: true,
      allow: {
        publishers: [".*/tf", ".*/battery_state"],
        subscribers: [],
        service_servers: [".*/route_server/DynamicEdgesScorer/adjust_edges"],
        service_clients: [],
        action_servers: [".*/navigate_to_pose"],
        action_clients: [],
      },
      pub_max_frequencies: [".*/battery_state=1"],
    },
  },
  // Zenoh related configurations
  mode: "client",
  connect: {
    endpoints: ["tcp/127.0.0.1:7447"]
  },
  listen: {
    endpoints: []
  },
  scouting: {
    multicast: {
      enabled: false,
    },
    gossip: {
      enabled: false,
    },
  },
}
